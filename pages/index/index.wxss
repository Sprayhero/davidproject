/* 页面基础样式 */
page {
  background: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

.container {
  padding: 0 30rpx;
  padding-bottom: 120rpx; /* 为底部导航栏留出空间 */
}

/* 头部样式 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 60rpx 0 40rpx 0;
  color: white;
}

.header-left {
  display: flex;
  align-items: center;
}

.school-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
  border-radius: 50%;
}

.school-name {
  font-size: 36rpx;
  font-weight: 600;
}

.header-right {
  width: 60rpx;
  height: 60rpx;
}

.search-icon {
  width: 100%;
  height: 100%;
}

/* 学生信息卡片 */
.student-card {
  background: linear-gradient(135deg, rgba(255,255,255,0.25) 0%, rgba(255,255,255,0.15) 100%);
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 60rpx;
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(10px);
  box-shadow: 0 20rpx 40rpx rgba(0,0,0,0.1);
}

.student-info {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
  border: 4rpx solid rgba(255,255,255,0.3);
}

.student-details {
  display: flex;
  flex-direction: column;
}

.student-name {
  font-size: 48rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 8rpx;
}

.student-class {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

.stats {
  display: flex;
  gap: 80rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 56rpx;
  font-weight: 700;
  color: white;
  line-height: 1;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

.trophy-icon {
  position: absolute;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 120rpx;
  height: 120rpx;
  opacity: 0.8;
}

/* 功能模块网格 */
.modules-grid {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.module-row {
  display: flex;
  gap: 40rpx;
}

.module-row .single {
  width: calc(50% - 20rpx);
}

.module-item {
  flex: 1;
  background: white;
  border-radius: 24rpx;
  padding: 50rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.1);
  transition: all 0.3s ease;
}

.module-item:active {
  transform: scale(0.95);
  box-shadow: 0 5rpx 15rpx rgba(0,0,0,0.2);
}

.module-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.module-icon image {
  width: 60rpx;
  height: 60rpx;
}

/* 不同模块的图标背景色 */
.behavior-icon {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
}

.academic-icon {
  background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
}

.activity-icon {
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
}

.health-icon {
  background: linear-gradient(135deg, #d299c2 0%, #fef9d7 100%);
}

.interest-icon {
  background: linear-gradient(135deg, #89f7fe 0%, #66a6ff 100%);
}

.art-icon {
  background: linear-gradient(135deg, #c471ed 0%, #f64f59 100%);
}

.personal-icon {
  background: linear-gradient(135deg, #fdbb2d 0%, #22c1c3 100%);
}

.module-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  text-align: center;
}

/* 底部导航栏 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: white;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 60rpx;
  box-shadow: 0 -10rpx 30rpx rgba(0,0,0,0.1);
  z-index: 100;
}

.nav-item {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.nav-item.active {
  background: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);
}

.nav-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-item.active .nav-icon {
  filter: brightness(0) invert(1);
}